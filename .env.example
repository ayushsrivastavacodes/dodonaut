# =============================================================================
# Dodonaut — Environment Variables
# Copy to apps/web/.env.local, apps/edge/.env.local, apps/reconciler/.env
# Each app reads only the keys it needs (validated by packages/shared/env.ts).
# =============================================================================

# ---- Dodonaut public ----
DODONAUT_BASE_URL=http://localhost:3000
DODONAUT_API_BASE=http://localhost:4021
NEXT_PUBLIC_DODONAUT_BASE_URL=http://localhost:3000
NEXT_PUBLIC_DODONAUT_API_BASE=http://localhost:4021

# ---- Database (Neon Postgres) ----
DATABASE_URL=postgres://USER:PASS@ep-xxx.region.aws.neon.tech/dodonaut?sslmode=require

# ---- Better-Auth ----
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=                 # openssl rand -base64 32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Dodo Payments ----
# Sandbox (Days 1-5):
DODO_PAYMENTS_API_KEY=dodo_test_xxx
DODO_PAYMENTS_WEBHOOK_SECRET=whsec_xxx
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Live (Day 6+):
# DODO_PAYMENTS_API_KEY=dodo_live_xxx
# DODO_PAYMENTS_ENVIRONMENT=live_mode
DODO_PAYMENTS_RETURN_URL=http://localhost:3000/checkout/success

# ---- Solana ----
# Devnet (Days 2-5):
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
# Mainnet (Day 6+):
# SOLANA_NETWORK=mainnet
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Token mints (Solana mainnet)
USDG_MINT_MAINNET=2u1tszSeqZ3qBWF3uNGPFc8TzMk2tdiwknnRMWGWjGWH
USDC_MINT_MAINNET=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# Token mint (Solana devnet)
USDC_MINT_DEVNET=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# CAIP-2 network identifiers (used in x402 accepts.network field)
SOLANA_MAINNET_CAIP2=solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp
SOLANA_DEVNET_CAIP2=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1

# ---- Helius ----
HELIUS_API_KEY=
HELIUS_WEBHOOK_SECRET=               # set as Authorization header in webhook config
HELIUS_WEBHOOK_ID=                   # populated after first webhook creation

# ---- x402 ----
# Devnet facilitator (Days 2-5):
X402_FACILITATOR_URL=https://x402.org/facilitator
# Mainnet facilitator (Day 6+):
# X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
# Fallback if Coinbase Solana support is thin: https://facilitator.payai.network
COINBASE_CDP_API_KEY=
COINBASE_CDP_API_SECRET=

# ---- Anthropic (optional setup agent / future) ----
ANTHROPIC_API_KEY=

# ---- Upstash Redis (BullMQ for reconciler retries) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Observability ----
AXIOM_API_TOKEN=
AXIOM_DATASET=dodonaut
SENTRY_DSN=
