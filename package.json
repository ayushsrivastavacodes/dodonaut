{
  "name": "dodonaut",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "bun --filter @dodonaut/db generate",
    "db:migrate": "bun --filter @dodonaut/db migrate",
    "db:studio": "bun --filter @dodonaut/db studio"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.7.3",
    "@types/node": "^22.10.0"
  },
  "packageManager": "bun@1.2.12",
  "engines": {
    "node": ">=20"
  }
}
