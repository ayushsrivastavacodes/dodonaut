# =============================================================================
# Dodonaut — apps/edge environment (x402 paywall)
# Usage: cp .env.example .env.local && fill in the blanks below
# =============================================================================

# ---- Database (read-only ideally) -----------------------------------------
DATABASE_URL=

# ---- x402 facilitator -----------------------------------------------------
# Days 2-5 (devnet): https://x402.org/facilitator
# Day 6+ (mainnet, primary): https://api.cdp.coinbase.com/platform/v2/x402
# Day 6+ (mainnet, fallback if Coinbase Solana is thin): https://facilitator.payai.network
X402_FACILITATOR_URL=https://x402.org/facilitator

# Coinbase CDP credentials (only required when X402_FACILITATOR_URL points to CDP)
COINBASE_CDP_API_KEY=
COINBASE_CDP_API_SECRET=

# ---- Solana ---------------------------------------------------------------
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Token mints — leave as-is
USDC_MINT_MAINNET=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
USDC_MINT_DEVNET=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# ---- Self ----------------------------------------------------------------
DODONAUT_API_BASE=http://localhost:4021
PORT=4021
