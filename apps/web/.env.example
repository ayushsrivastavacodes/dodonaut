# =============================================================================
# Dodonaut — apps/web environment
# Usage: cp .env.example .env.local && fill in the blanks below
# =============================================================================

# ---- Database (Neon Postgres) ---------------------------------------------
# Get from neon.tech → your project → Connection Details → connection string
DATABASE_URL=

# ---- Better-Auth ----------------------------------------------------------
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# ---- Google OAuth ---------------------------------------------------------
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Dodo Payments --------------------------------------------------------
# Dashboard → switch to Test Mode → Developer → API Keys
DODO_PAYMENTS_API_KEY=
# Dashboard → Test Mode → Developer → Webhooks → Add Endpoint → Signing Secret
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_RETURN_URL=http://localhost:3000/checkout/success

# ---- Public (exposed to browser) ------------------------------------------
NEXT_PUBLIC_DODONAUT_BASE_URL=http://localhost:3000
NEXT_PUBLIC_DODONAUT_API_BASE=http://localhost:4021
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# ---- Solana ---------------------------------------------------------------
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Token mints — these are constants, leave as-is unless using a different cluster
USDG_MINT_MAINNET=2u1tszSeqZ3qBWF3uNGPFc8TzMk2tdiwknnRMWGWjGWH
USDC_MINT_MAINNET=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
USDC_MINT_DEVNET=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
