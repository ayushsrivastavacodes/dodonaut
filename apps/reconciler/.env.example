# =============================================================================
# Dodonaut — apps/reconciler environment (Helius + Dodo Usage Events)
# Usage: cp .env.example .env && fill in the blanks below
# Note: file is `.env` here (not .env.local) — Bun + Fly.io read .env directly
# =============================================================================

# ---- Database -------------------------------------------------------------
DATABASE_URL=

# ---- Helius ---------------------------------------------------------------
# Get from helius.dev → Developer plan ($19/mo) → API Keys
HELIUS_API_KEY=
# Set this to a random 32-char string. You'll paste it into the webhook config
# in Helius dashboard as the Authorization header. The reconciler verifies
# every inbound webhook against this value.
HELIUS_WEBHOOK_SECRET=
# Populated after first webhook creation (POST to Helius API). Optional for boot.
HELIUS_WEBHOOK_ID=

# ---- Dodo Payments --------------------------------------------------------
# Same key as apps/web's .env.local (test_mode for Days 1-5, live_mode Day 6+)
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode

# ---- Solana ---------------------------------------------------------------
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# Token mints — leave as-is
USDG_MINT_MAINNET=2u1tszSeqZ3qBWF3uNGPFc8TzMk2tdiwknnRMWGWjGWH
USDC_MINT_MAINNET=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# ---- Self ----------------------------------------------------------------
PORT=8080
